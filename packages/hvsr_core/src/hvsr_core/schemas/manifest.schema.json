{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hvsr-analyzer.example/schemas/manifest/2.0.0.json",
  "title": "HVSR Analyzer measurement manifest",
  "description": "Machine-readable index of every artifact of one measurement. Links are stable API endpoints (never expiring signed URLs).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "measurement_id", "record_code", "geohash", "decimal_year", "decimal_year_source", "created_utc", "metadata_revision", "metadata", "original_bytes_retained", "categories", "licensing", "provenance", "moderation"],
  "properties": {
    "schema_id": {"const": "hvsr-analyzer/manifest"},
    "schema_version": {"const": "2.0.0"},
    "measurement_id": {"type": "string", "format": "uuid"},
    "record_code": {"type": "string", "pattern": "^[0-9b-hjkmnp-z]{5}-[0-9]{4}\\.[0-9]{4}(-[0-9]{2,})?$"},
    "geohash": {"type": "string", "pattern": "^[0-9b-hjkmnp-z]{12}$"},
    "decimal_year": {"type": "number"},
    "decimal_year_source": {"enum": ["recording_start", "upload_time"]},
    "site_group_id": {"type": ["string", "null"]},
    "created_utc": {"$ref": "#/$defs/utc"},
    "metadata_revision": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object"},
    "original_bytes_retained": {"type": "boolean"},
    "original_bytes_note": {"type": ["string", "null"]},
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_data", "canonical_recordings", "sensor_metadata", "analysis_runs", "spectra", "plots", "templates", "provenance", "licensing", "quality_evaluation"],
      "properties": {
        "original_data": {"$ref": "#/$defs/artifact_list"},
        "canonical_recordings": {"$ref": "#/$defs/artifact_list"},
        "sensor_metadata": {"$ref": "#/$defs/artifact_list"},
        "analysis_runs": {"$ref": "#/$defs/artifact_list"},
        "spectra": {"$ref": "#/$defs/artifact_list"},
        "plots": {"$ref": "#/$defs/artifact_list"},
        "templates": {"$ref": "#/$defs/artifact_list"},
        "provenance": {"$ref": "#/$defs/artifact_list"},
        "licensing": {"$ref": "#/$defs/artifact_list"},
        "quality_evaluation": {"$ref": "#/$defs/artifact_list"}
      }
    },
    "licensing": {
      "type": "object",
      "required": ["license_id", "license_url", "attribution", "source_citation", "consent_version", "consent_text_sha256", "consent_utc", "rights_confirmed", "modification_history"],
      "properties": {
        "license_id": {"const": "CC-BY-4.0"},
        "license_url": {"const": "https://creativecommons.org/licenses/by/4.0/"},
        "attribution": {"type": "string", "minLength": 1},
        "source_citation": {"type": ["string", "null"]},
        "consent_version": {"type": "string"},
        "consent_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "consent_utc": {"$ref": "#/$defs/utc"},
        "rights_confirmed": {"const": true},
        "modification_history": {"type": "array", "items": {"type": "object"}},
        "removal_notice": {"type": "string"}
      }
    },
    "provenance": {"type": "object"},
    "moderation": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["public", "removed", "under_review"]}, "contact": {"type": ["string", "null"]}}
    }
  },
  "$defs": {
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "artifact_list": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "label", "kind", "url", "mime_type", "byte_size", "sha256", "availability", "availability_reason", "generated_by", "run_id", "method", "source_refs"],
      "properties": {
        "artifact_id": {"type": "string"},
        "label": {"type": "string"},
        "kind": {"type": "string"},
        "url": {"type": "string", "pattern": "^/api/"},
        "mime_type": {"type": "string"},
        "byte_size": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "availability": {"enum": ["available", "on_demand", "unavailable", "removed"]},
        "availability_reason": {"type": ["string", "null"]},
        "generated_by": {"type": "object"},
        "run_id": {"type": ["string", "null"]},
        "method": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
