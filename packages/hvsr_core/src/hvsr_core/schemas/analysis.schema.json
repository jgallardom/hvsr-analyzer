{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hvsr-analyzer.example/schemas/analysis/2.0.0.json",
  "title": "HVSR Analyzer per-run, per-method analysis",
  "description": "One method (standard, standard_basic_audit, sdof, or an optional template family) of one immutable analysis run. Units are given in field names (_hz, _s) or in the 'units' block. Unavailable numbers are null with a reason; NaN/Infinity are never used.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "run_id", "method", "method_status", "method_status_reason",
    "generated_utc", "record", "provenance", "config", "config_hash", "derived_operations",
    "instrument", "recording", "grid", "windows", "selections", "peak_families", "interpretation",
    "quality_dimensions", "calibration", "units", "ci_label", "sesame_requested"
  ],
  "properties": {
    "schema_id": {"const": "hvsr-analyzer/analysis"},
    "schema_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "method": {"enum": ["standard", "standard_basic_audit", "sdof", "mdof2", "mdof3"]},
    "method_status": {"enum": ["computed", "not_computable", "no_eligible_windows"]},
    "method_status_reason": {"type": ["string", "null"]},
    "generated_utc": {"$ref": "#/$defs/utc"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_code", "measurement_id", "metadata_revision", "latitude", "longitude", "measurement_context"],
      "properties": {
        "record_code": {"type": ["string", "null"]},
        "measurement_id": {"type": ["string", "null"]},
        "metadata_revision": {"type": ["integer", "null"], "minimum": 1},
        "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "measurement_context": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["software_version", "algorithm_versions", "git_commit", "dependencies", "input_hashes", "config_hash", "template_bank", "numeric_backend"],
      "properties": {
        "software_version": {"type": "string"},
        "algorithm_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "git_commit": {"type": ["string", "null"]},
        "git_dirty": {"type": ["boolean", "null"]},
        "container_image": {"type": ["string", "null"]},
        "dependencies": {"type": "object", "additionalProperties": {"type": "string"}},
        "numeric_backend": {"type": "object"},
        "input_hashes": {"type": "object", "additionalProperties": {"type": ["string", "null", "array"]}},
        "response_sha256": {"type": ["string", "null"]},
        "config_hash": {"$ref": "#/$defs/sha256"},
        "template_bank": {
          "type": ["object", "null"],
          "properties": {
            "bank_id": {"type": "string"},
            "bank_version": {"type": "string"},
            "data_sha256": {"$ref": "#/$defs/sha256"},
            "family": {"type": "string"},
            "conditioning": {"type": "object"}
          },
          "required": ["bank_id", "bank_version", "data_sha256", "family", "conditioning"]
        }
      }
    },
    "config": {"type": "object"},
    "config_hash": {"$ref": "#/$defs/sha256"},
    "derived_operations": {
      "type": "array",
      "items": {"type": "object", "required": ["operation", "parameters"], "properties": {"operation": {"type": "string"}, "parameters": {"type": "object"}}}
    },
    "instrument": {
      "type": "object",
      "required": ["status", "reasons", "flags", "correction", "usable_band_hz"],
      "properties": {
        "status": {"enum": ["verified_common_quantity", "provisional_uncalibrated", "invalid"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "flags": {"type": "array", "items": {"type": "string"}},
        "correction": {"enum": ["none", "scalar_sensitivity"]},
        "usable_band_hz": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": ["number", "null"]}}
      }
    },
    "recording": {
      "type": "object",
      "required": ["sampling_rate_hz", "start_utc", "raw_duration_s", "analyzed_start_s", "analyzed_end_s", "segment_count", "window_length_samples", "window_length_s", "step_samples", "step_s", "fft_resolution_hz", "nyquist_hz"],
      "properties": {
        "sampling_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "start_utc": {"oneOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
        "raw_duration_s": {"type": "number", "minimum": 0},
        "analyzed_start_s": {"type": "number", "minimum": 0},
        "analyzed_end_s": {"type": "number", "minimum": 0},
        "segment_count": {"type": "integer", "minimum": 0},
        "window_length_samples": {"type": "integer", "minimum": 1},
        "window_length_s": {"type": "number", "exclusiveMinimum": 0},
        "step_samples": {"type": "integer", "minimum": 1},
        "step_s": {"type": "number", "exclusiveMinimum": 0},
        "fft_resolution_hz": {"type": "number", "exclusiveMinimum": 0},
        "nyquist_hz": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "grid": {
      "type": "object",
      "required": ["definition", "points_per_decade", "frequency_hz", "valid", "invalid_reasons"],
      "properties": {
        "definition": {"type": "string"},
        "points_per_decade": {"type": "integer"},
        "frequency_hz": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
        "valid": {"type": "array", "items": {"type": "boolean"}},
        "invalid_reasons": {"type": "object", "additionalProperties": {"type": "integer"}},
        "smoothing_effective_bins": {"$ref": "#/$defs/nullable_numbers"}
      }
    },
    "windows": {
      "type": "object",
      "required": ["candidate_count", "qc_passed_count", "rejected_by_reason", "candidates_url"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "qc_passed_count": {"type": "integer", "minimum": 0},
        "rejected_by_reason": {"type": "object", "additionalProperties": {"type": "integer"}},
        "candidates_url": {"type": ["string", "null"]}
      }
    },
    "selections": {"type": "array", "items": {"$ref": "#/$defs/selection"}},
    "peak_families": {"type": "array", "items": {"$ref": "#/$defs/family"}},
    "interpretation": {
      "type": "object",
      "required": ["status", "fundamental_frequency_candidate_hz", "evidence", "flags", "human_annotations_url"],
      "properties": {
        "status": {"$ref": "#/$defs/interpretation_status"},
        "fundamental_frequency_candidate_hz": {"type": ["number", "null"]},
        "fundamental_family_id": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "flags": {"type": "array", "items": {"type": "string"}},
        "human_annotations_url": {"type": ["string", "null"]}
      }
    },
    "quality_dimensions": {
      "type": "object",
      "required": ["usability", "peak_identifiability", "sensitivity", "summary_score"],
      "properties": {
        "usability": {"type": "object"},
        "peak_identifiability": {"type": "object"},
        "sensitivity": {"type": "object"},
        "summary_score": {"type": ["object", "null"]}
      }
    },
    "calibration": {
      "type": "object",
      "required": ["status", "profile", "note"],
      "properties": {
        "status": {"enum": ["uncalibrated", "calibrated_profile"]},
        "profile": {"type": ["string", "null"]},
        "note": {"type": "string"}
      }
    },
    "units": {"type": "object", "additionalProperties": {"type": "string"}},
    "ci_label": {"const": "Estimated 95% pointwise CI for the selected-window mean"},
    "sesame_requested": {"type": "boolean"},
    "robustness_comparison_url": {"type": ["string", "null"]},
    "licensing": {"type": ["object", "null"]},
    "external": {"type": "boolean"}
  },
  "$defs": {
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_numbers": {"type": "array", "items": {"type": ["number", "null"]}},
    "interpretation_status": {"enum": ["single_plausible_peak", "multiple_plausible_peaks", "no_clear_peak", "possible_source_peak", "lower_band_unresolved", "not_computable"]},
    "ci_status": {"enum": ["ci_estimated", "ci_limited", "ci_not_estimable", "not_computed"]},
    "peak_estimate": {
      "type": "object",
      "required": ["peak_family_id", "observed_peak_frequency_hz", "observed_peak_amplitude", "status"],
      "properties": {
        "peak_family_id": {"type": "string"},
        "status": {"enum": ["peak_found", "no_peak_in_family_band", "not_evaluable"]},
        "observed_peak_frequency_hz": {"type": ["number", "null"]},
        "observed_peak_amplitude": {"type": ["number", "null"]},
        "window_peak_frequency_hz": {"type": "object"},
        "bootstrap": {"type": ["object", "null"]}
      }
    },
    "selection": {
      "type": "object",
      "required": ["selection_id", "peak_family_id", "status", "status_reason", "selection_rule", "selection_conditional", "n_selected", "n_requested", "window_ids", "window_start_samples", "mean_curve", "uncertainty", "peaks", "maximum", "templates", "sesame"],
      "properties": {
        "selection_id": {"type": "string"},
        "peak_family_id": {"type": ["string", "null"]},
        "status": {"enum": ["computed", "insufficient_matches", "no_eligible_windows", "not_computable"]},
        "status_reason": {"type": ["string", "null"]},
        "selection_rule": {"type": "string"},
        "selection_conditional": {"type": "boolean"},
        "n_selected": {"type": "integer", "minimum": 0},
        "n_requested": {"type": ["integer", "null"]},
        "window_ids": {"type": "array", "items": {"type": "string"}},
        "window_start_samples": {"type": "array", "items": {"type": "integer"}},
        "mean_curve": {
          "type": "object",
          "required": ["hv_geometric_mean", "ci95_lower", "ci95_upper", "count", "log_std"],
          "properties": {
            "hv_geometric_mean": {"$ref": "#/$defs/nullable_numbers"},
            "ci95_lower": {"$ref": "#/$defs/nullable_numbers"},
            "ci95_upper": {"$ref": "#/$defs/nullable_numbers"},
            "count": {"type": "array", "items": {"type": "integer", "minimum": 0}},
            "log_std": {"$ref": "#/$defs/nullable_numbers"}
          }
        },
        "uncertainty": {
          "type": "object",
          "required": ["status", "status_reason", "method", "label", "selection_conditional", "coverage_calibrated", "seed", "n_bootstrap"],
          "properties": {
            "status": {"$ref": "#/$defs/ci_status"},
            "status_reason": {"type": ["string", "null"]},
            "method": {"type": "string"},
            "label": {"const": "Estimated 95% pointwise CI for the selected-window mean"},
            "selection_conditional": {"const": true},
            "coverage_calibrated": {"type": "boolean"},
            "seed": {"type": ["integer", "null"]},
            "n_bootstrap": {"type": ["integer", "null"]},
            "block_length_s": {"type": ["number", "null"]},
            "informative_blocks": {"type": ["integer", "null"]},
            "dependence": {"type": ["object", "null"]},
            "sensitivity": {"type": ["array", "null"]}
          }
        },
        "peaks": {"type": "array", "items": {"$ref": "#/$defs/peak_estimate"}},
        "maximum": {
          "type": "object",
          "required": ["maximum_amplitude", "maximum_frequency_hz"],
          "properties": {
            "maximum_amplitude": {"type": ["number", "null"]},
            "maximum_frequency_hz": {"type": ["number", "null"]}
          }
        },
        "templates": {"type": ["object", "null"]},
        "sesame": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["not_requested", "evaluated", "not_evaluable"]}}}
      }
    },
    "family": {
      "type": "object",
      "required": ["family_id", "center_frequency_hz", "lower_bound_hz", "upper_bound_hz", "recurrence", "plausible", "flags", "evidence"],
      "properties": {
        "family_id": {"type": "string"},
        "center_frequency_hz": {"type": "number"},
        "lower_bound_hz": {"type": "number"},
        "upper_bound_hz": {"type": "number"},
        "recurrence": {"type": "number", "minimum": 0, "maximum": 1},
        "discovery_windows_with_peak": {"type": "integer"},
        "mean_curve_peak_frequency_hz": {"type": ["number", "null"]},
        "mean_curve_peak_amplitude": {"type": ["number", "null"]},
        "mean_curve_prominence_ratio": {"type": ["number", "null"]},
        "plausible": {"type": "boolean"},
        "flags": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "object"}
      }
    }
  }
}
