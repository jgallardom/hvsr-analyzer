# HVSR Analyzer environment. Copy to .env (never committed) or set in the hosting dashboard.
# Every HVSR_* name is a field of src/hvsr_web/settings.py; values shown are the defaults unless noted.
# Byte ceilings and quotas are operational defaults to benchmark, not scientific standards;
# docs/performance.md and docs/deployment.md give the measured budgets they were set against.

# --- storage (secrets: fill in, never commit) ---------------------------------------------------
# SQLite for one machine; PostgreSQL for a deployment (postgres:// and postgresql:// URLs accepted).
HVSR_DATABASE_URL=sqlite:///./var/hvsr.sqlite3
# local (a directory, development only) or s3 (any S3-compatible bucket, e.g. Cloudflare R2)
HVSR_OBJECT_STORE=local
HVSR_LOCAL_STORE_DIR=./var/objects
HVSR_S3_BUCKET=
# e.g. https://<account-id>.r2.cloudflarestorage.com for R2
HVSR_S3_ENDPOINT_URL=
# auto for R2
HVSR_S3_REGION=
# S3 credentials use the standard variable names
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# HMAC key for local-store signed download URLs (32+ random bytes); a per-process key if empty
HVSR_URL_SIGNING_KEY=
HVSR_SIGNED_URL_TTL_S=300
HVSR_BANK_DIR=./var/banks

# --- public identity of the site -----------------------------------------------------------------
# absolute URL used in citations, e.g. https://hvsr.example.org
HVSR_PUBLIC_BASE_URL=
# where removal requests go (shown on every measurement page)
HVSR_MODERATION_CONTACT=

# --- contributor quota -----------------------------------------------------------------------------
HVSR_MONTHLY_QUOTA_BYTES=1073741824
HVSR_GUEST_UPLOADS_ENABLED=false
HVSR_GUEST_POOL_MONTHLY_BYTES=268435456

# --- input ceilings (checked before any quota is charged) -----------------------------------------
HVSR_MAX_REQUEST_BYTES=134217728
HVSR_MAX_DECODED_BYTES=805306368
HVSR_MAX_DECOMPRESSION_RATIO=200.0
HVSR_MAX_SAMPLES_PER_CHANNEL=8640000
HVSR_MAX_CHANNELS=12
HVSR_MAX_FILES=6
HVSR_MAX_DURATION_S=172800.0

# --- compute ceilings ----------------------------------------------------------------------------
HVSR_MAX_CANDIDATE_WINDOWS=20000
HVSR_MAX_BOOTSTRAP_REPLICATES=2000
HVSR_MAX_TEMPLATE_COMPARISONS=200000000
HVSR_MAX_PARAMETER_RUNS=2
HVSR_MAX_WINDOW_SPECTRA_CELLS=2000000
HVSR_MAX_PLOT_PIXELS=16000000
HVSR_MAX_PLOT_VARIANTS_PER_RUN=50
HVSR_MAX_BANK_BYTES=67108864
HVSR_BANK_LICENSES=CC0-1.0,CC-BY-4.0,BSD-3-Clause,MIT,Apache-2.0

# --- concurrency, jobs, and isolation --------------------------------------------------------------
# uploads read and parsed at once per web process; others wait, then get 503 busy
HVSR_MAX_CONCURRENT_UPLOADS=1
HVSR_UPLOAD_WAIT_S=30.0
# analysis jobs running at once across all workers (a database-enforced ceiling)
HVSR_MAX_CONCURRENT_JOBS=1
HVSR_JOB_LEASE_S=900
HVSR_JOB_MAX_ATTEMPTS=3
HVSR_JOB_WALL_TIME_S=900
HVSR_JOB_CPU_TIME_S=900
# address space a job may add to its process baseline (Linux RLIMIT_AS)
HVSR_JOB_MEMORY_BYTES=2147483648
# process: each job in a fresh child process under the limits above; inline: tests only
HVSR_JOB_ISOLATION=process
HVSR_NUMERIC_THREADS=1
HVSR_STAGING_TTL_S=86400
# run the job worker inside the web process (single-service deployments such as render.yaml)
HVSR_EMBEDDED_WORKER=false
HVSR_WORKER_POLL_S=2.0

# --- not settings: read only by specific tools ----------------------------------------------------
# administrator token for `python -m hvsr_web.admin banks ...` (export in the shell; never in a file)
# HVSR_ADMIN_TOKEN=
# commit recorded in analysis provenance when git is unavailable (set by the container entry point)
# HVSR_GIT_COMMIT=
# PostgreSQL server for the deployment-database tests (otherwise a throwaway pgserver is started)
# HVSR_TEST_POSTGRES_URL=postgresql://postgres@localhost:5432/postgres
# extra template-bank directories for the offline `hvsr` tool (os.pathsep-separated)
# HVSR_BANK_DIRS=
# allows schema downgrades; set only for one command, after verifying a backup (docs/backup-restore.md)
# HVSR_ALLOW_DESTRUCTIVE_MIGRATIONS=
